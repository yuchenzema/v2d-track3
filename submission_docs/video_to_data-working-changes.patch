+@pytest.mark.parametrize("base_angle", [0.0, 0.65])
+def test_voc_stably_damps_a_thin_object_about_its_low_inertia_axis(base_angle):
+    """A spoon-like plate must settle at 100 Hz in either world orientation."""
+    import warp as wp
+    import newton
+    from flash_chord.runtime.object_control import apply_object_control
+
+    with wp.ScopedDevice("cuda:0"):
+        builder = newton.ModelBuilder()
+        newton.solvers.SolverMuJoCo.register_custom_attributes(builder)
+        builder.default_shape_cfg.density = 733.333333
+        body = builder.add_body(label="thin_tool")
+        builder.add_joint_free(child=body)
+        builder.add_shape_box(body, hx=0.15, hy=0.015, hz=0.0025)
+        base = wp.quat_from_axis_angle(wp.vec3(0.0, 1.0, 0.0), base_angle)
+        displaced = wp.mul(base, wp.quat_from_axis_angle(wp.vec3(1.0, 0.0, 0.0), 0.3))
+        q = np.asarray(builder.joint_q, dtype=float)
+        q[:3] = [0.0, 0.0, 0.6]
+        q[3:7] = np.asarray(displaced)
+        builder.joint_q = q.tolist()
+        model = builder.finalize()
+        solver = newton.solvers.SolverMuJoCo(
+            model, solver="newton", integrator="implicitfast",
+            njmax=50, nconmax=50, iterations=20, ls_iterations=10,
+            use_mujoco_contacts=False,
+        )
+        s0, s1 = model.state(), model.state()
+        newton.eval_fk(model, model.joint_q, model.joint_qd, s0)
+        control, contacts = model.control(), model.contacts()
+        command = _command(
+            world_count=1, num_joint_q=model.joint_coord_count,
+            num_joint_dof=model.joint_dof_count, bodies_per_world=model.body_count,
+            body_ids=(0,), target_pos=((0.0, 0.0, 0.6),),
+            target_quat=(tuple(base),),
+        )
+        scale = wp.ones(1, dtype=wp.float32)
+        errors = []
+        for _ in range(200):
+            s0.clear_forces()
+            apply_object_control(model, s0, control, command, scale)
+            solver.step(s0, s1, control, contacts, 0.01)
+            s0, s1 = s1, s0
+            pose = s0.body_q.numpy()[0]
+            assert np.isfinite(pose).all()
+            errors.append(2 * np.arccos(np.clip(abs(np.dot(pose[3:], np.asarray(base))), 0, 1)))
+    assert max(errors) < 0.35
+    assert errors[-1] < 0.01
